{
  "name": "timeloom",
  "version": "0.1.0",
  "description": "Automatic, content-addressed snapshots for your project. Rewind to the last version that actually worked — no git knowledge required.",
  "keywords": [
    "snapshot",
    "undo",
    "time-machine",
    "backup",
    "vibe-coding",
    "content-addressed",
    "restore",
    "watch"
  ],
  "homepage": "https://github.com/Chris-biu/timeloom#readme",
  "bugs": {
    "url": "https://github.com/Chris-biu/timeloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chris-biu/timeloom.git"
  },
  "license": "MIT",
  "author": "Chris-biu",
  "type": "module",
  "engines": {
    "node": ">=20.13.0"
  },
  "bin": {
    "timeloom": "./dist/cli/main.js",
    "tl": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
